<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="amberol-glass-lyrics">
  <enum id="io.github.amberolglass.Lyrics.ReplayGainMode">
    <value nick="album" value="0"/>
    <value nick="track" value="1"/>
    <value nick="off" value="2"/>
  </enum>
	<schema id="io.github.amberolglass.Lyrics" path="/io/github/amberolglass/Lyrics/">
	  <key name="window-width" type="i">
	    <default>1170</default>
	  </key>
	  <key name="window-height" type="i">
	    <default>720</default>
	  </key>
	  <key name="enable-recoloring" type="b">
	    <default>true</default>
	  </key>
    <key name="replay-gain" enum="io.github.amberolglass.Lyrics.ReplayGainMode">
      <default>'off'</default>
    </key>
	  <key name="background-play" type="b">
	    <default>true</default>
	  </key>
	</schema>
</schemalist>
