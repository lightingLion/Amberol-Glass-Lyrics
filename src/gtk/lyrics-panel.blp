using Gtk 4.0;

template $AmberolLyricsPanel: Widget {
  Box {
    orientation: vertical;
    hexpand: true;
    vexpand: true;
    overflow: hidden;

    styles ["lyrics-card"]

    Box {
      margin-top: 24;
      margin-start: 26;
      margin-end: 20;
      margin-bottom: 8;
      spacing: 10;

      Box {
        orientation: vertical;
        hexpand: true;
        spacing: 3;

        Label {
          label: _("Now Playing");
          halign: start;
          styles ["lyrics-kicker"]
        }

        Label title_label {
          label: _("Lyrics");
          halign: start;
          ellipsize: end;
          styles ["heading"]
        }
      }

      Button close_button {
        icon-name: "window-close-symbolic";
        valign: start;
        tooltip-text: _("Hide Lyrics");
        action-name: "win.close-lyrics";
        styles ["circular", "flat", "glass-button"]
      }
    }

    Overlay {
      vexpand: true;

      child: $AmberolReactionDiffusionView reaction_background {
        hexpand: true;
        vexpand: true;
        styles ["reaction-background"]
      };

      [overlay]
      Box {
        visible: false;
        orientation: vertical;
        valign: center;
        spacing: 24;
        margin-start: 28;
        margin-end: 28;
        margin-top: 20;
        margin-bottom: 20;

        Label older_label {
          wrap: true;
          justify: center;
          styles ["lyric-older"]
        }
        Label previous_label {
          wrap: true;
          justify: center;
          styles ["lyric-previous"]
        }
        Label current_label {
          label: _("No lyrics found");
          wrap: true;
          justify: center;
          selectable: true;
          styles ["lyric-current"]
        }
        Label next_label {
          wrap: true;
          justify: center;
          styles ["lyric-previous"]
        }
        Label later_label {
          wrap: true;
          justify: center;
          styles ["lyric-older"]
        }
      }

      [overlay]
      Label status_label {
        label: _("No synced lyrics found");
        halign: center;
        valign: center;
        wrap: true;
        styles ["dim-label", "lyrics-empty-state"]
      }
    }
  }
}
